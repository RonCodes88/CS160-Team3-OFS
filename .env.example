# Copy to .env.local and fill in. Never commit .env.local.
# Required server variables are checked at startup (src/lib/env.ts).
# Optional email, proxy, and simulator settings are validated by their consumers.

# ---------- Supabase ----------
# Values: Supabase dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only secret key (Supabase dashboard -> Project Settings -> API Keys -> Secret keys).
# Never add a NEXT_PUBLIC_ prefix: it bypasses row-level security.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Required by Docker's automatic migration step. Supabase dashboard -> Connect ->
# PostgreSQL connection string. Use the session pooler if direct IPv6 is unavailable.
# Replace the database password; percent-encode reserved characters in it.
# Must point to the SAME project as NEXT_PUBLIC_SUPABASE_URL. Server-only.
OFS_DATABASE_URL=postgresql://postgres.your-project-ref:your-encoded-password@your-session-pooler-host:5432/postgres

# ---------- Stripe (TEST MODE ONLY: live keys are rejected) ----------
# Stripe dashboard, test mode -> Developers -> API keys.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Local: run `stripe listen --forward-to localhost:3000/api/webhooks/stripe` and copy the whsec_ it prints.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------- Mapbox ----------
# Mapbox account -> Tokens. Server token for geocoding and routing (keep it secret).
MAPBOX_ACCESS_TOKEN=sk.xxx
# Public pk. token for the tracking map. Restrict it to your site's URLs in Mapbox.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.xxx

# ---------- Delivery service area ----------
# Saved addresses and checkout are limited to this distance from the store.
OFS_STORE_LATITUDE=37.3352
OFS_STORE_LONGITUDE=-121.8811
OFS_DELIVERY_RADIUS_METERS=5000

# ---------- Integration tests only ----------
# Put these in .env.test.local, pointing at a LOCAL Supabase (`npx supabase start`,
# then copy values from `npx supabase status`). Tests refuse to run against
# anything that isn't localhost.
# SUPABASE_TEST_URL=http://127.0.0.1:54321
# SUPABASE_TEST_SECRET_KEY=sb_secret_xxx

# Delivery worker: positive minutes; checked once per minute.
OFS_DELIVERY_WAIT_MINUTES=20

# ---------- Optional outbound email ----------
# Disabled until a verified sender and provider key are configured. No real email
# is sent by tests. Configure these in the deployment secret store.
OFS_EMAIL_PROVIDER=disabled
OFS_EMAIL_FROM=
RESEND_API_KEY=

# ---------- Trusted reverse proxy ----------
# Optional. Leave false unless a proxy in front of the app overwrites
# X-Forwarded-For with the real client IP and cannot be bypassed. When false,
# the client IP is unknown and all visitors share one budget (300 sign-ups and
# 600 failed logins per 15 minutes); each account still allows only 10 failed
# logins. When true, each IP gets its own tighter budget (30).
OFS_TRUST_PROXY_HEADERS=false

# ---------- Robot simulator (test deployments only) ----------
OFS_ROBOT_BASE_URL=http://127.0.0.1:3000
OFS_ROBOT_EMAIL=
OFS_ROBOT_PASSWORD=
OFS_ROBOT_POLL_MS=5000
OFS_ROBOT_STEP_MS=500
# Optional: positions reported along the road before each stop (0 = jump
# straight to the stop), and the wait at the door before DELIVERED.
# OFS_ROBOT_DRIVE_STEPS=0
# OFS_ROBOT_ARRIVAL_WAIT_MS=500

# ---------- Run the background jobs inside the website (demos) ----------
# true: `npm run dev` or `docker compose up` also runs delivery batching,
# payment recovery and email sending every minute, so the whole flow works
# without a terminal. Turn it on for ONE running copy of the site per database,
# and don't also run the worker scripts against that database.
OFS_IN_APP_WORKERS=false
# Optional, demos only: how often the in-app delivery batching runs, in seconds
# (5 to 60). The rule is every minute, so leave it unset outside a demo.
# OFS_DELIVERY_TICK_SECONDS=60
# true: the website also runs the simulated robot, signed in with
# OFS_ROBOT_EMAIL and OFS_ROBOT_PASSWORD. It drives along the route at a demo
# pace unless the OFS_ROBOT_* timing settings above are set: one move every
# 8 s, 10 moves per stop, 30 s at the door.
OFS_IN_APP_ROBOT=false
