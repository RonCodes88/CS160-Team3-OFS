# Copy to .env.local and fill in. Never commit .env.local.
# Every variable below is checked when the server starts (src/lib/env.ts):
# production refuses to start if any is missing; dev prints a warning.

# ---------- Supabase ----------
# Values: Supabase dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only secret key (Supabase dashboard -> Project Settings -> API Keys -> Secret keys).
# Never add a NEXT_PUBLIC_ prefix: it bypasses row-level security.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ---------- Stripe (TEST MODE ONLY: live keys are rejected) ----------
# Stripe dashboard, test mode -> Developers -> API keys.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Local: run `stripe listen --forward-to localhost:3000/api/webhooks/stripe` and copy the whsec_ it prints.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---------- Mapbox ----------
# Mapbox account -> Tokens. Server token for geocoding and routing (keep it secret).
MAPBOX_ACCESS_TOKEN=sk.xxx
# Public pk. token for the tracking map. Restrict it to your site's URLs in Mapbox.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.xxx

# ---------- Delivery service area ----------
# Saved addresses and checkout are limited to this distance from the store.
OFS_STORE_LATITUDE=37.3352
OFS_STORE_LONGITUDE=-121.8811
OFS_DELIVERY_RADIUS_METERS=5000

# ---------- Integration tests only ----------
# Put these in .env.test.local, pointing at a LOCAL Supabase (`npx supabase start`,
# then copy values from `npx supabase status`). Tests refuse to run against
# anything that isn't localhost.
# SUPABASE_TEST_URL=http://127.0.0.1:54321
# SUPABASE_TEST_SECRET_KEY=sb_secret_xxx

# Delivery worker: positive minutes; checked once per minute.
OFS_DELIVERY_WAIT_MINUTES=20
